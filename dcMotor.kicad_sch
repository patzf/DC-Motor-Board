	(text "VM:  4.5-V to 33-V supply rail\nf_{PWM}: 0 - 200kHz\nlogic inputs: 100k internal PD\nIN1 = IN2 = 0 for t>1.5ms : low power mode\n\nIN1 = 1 && IN2 = 0 -> Forward\nIN1 = 1 && IN2 = 1 -> Slow decay\nIN1 = 0 && IN2 = 0 -> Fast decay\n\nFW fast :\nIN1: 1 -> 0, IN2: always 0\nFW slow :\nIN1: always 1, IN2: 0 -> 1"
		(exclude_from_sim no)
		(at 358.902 120.396 0)
